#!/usr/bin/env python3
"""Stand-in for ssh in tests. Never connects anywhere."""
import json
import os
import sys

argv = sys.argv[1:]
path = os.environ.get("FAKE_SSH_ARGV_FILE")
if path:
    with open(path, "w") as f:
        json.dump(argv, f)

code = int(os.environ.get("FAKE_SSH_EXIT") or 0)
if code:
    print("ssh: fake failure", file=sys.stderr)
    sys.exit(code)

for command, var in (("squeue", "FAKE_SSH_SQUEUE"), ("sacct", "FAKE_SSH_SACCT")):
    if command in argv:
        file = os.environ.get(var)
        sys.stdout.write(open(file).read() if file else '{"jobs": []}')
        break
