# Copy to .env next to compose.yaml and fill in.

# Folder that holds your project folders, for example /home/you/Projects; mounted read-only
# at /projects. Required: compose stops while it is empty or names a folder that does not
# exist. Never put the instance directory inside it.
TRAJECTREE_PROJECTS_ROOT=
# Time zone for schedules and dates (IANA name).
TZ=UTC
# Your host user and group ids (`id -u`, `id -g`); the container runs as them.
UID=1000
GID=1000
# Host port the daemon is published on (127.0.0.1 only). The host clients (`trajectree`,
# the MCP shim, the hooks) read the URL from ~/.config/trajectree/url; keep it in step.
TRAJECTREE_HOST_PORT=8742
# Git repository the image is built from.
TRAJECTREE_GIT_URL=https://github.com/yu17/Trajectree.git
# Branch, tag or commit to build.
TRAJECTREE_REF=main
# Seconds between ingest passes; 0 disables the loop.
TRAJECTREE_INGEST_EVERY=300
# Ignore transcripts and commits older than this many days.
TRAJECTREE_SCAN_SINCE_DAYS=365
# Seconds of silence that split a session into work segments; empty means 7200.
TRAJECTREE_SEGMENT_GAP_S=
# Seconds without a Stop before a hooked session is ended as idle; empty means the segment gap.
TRAJECTREE_SESSION_IDLE_S=
# Characters of transcript digest one inspection run reads; empty means 40000.
# Keep it above TRAJECTREE_DIGEST_MAX_CHARS (12000) plus a little overhead.
TRAJECTREE_INSPECT_BUDGET_CHARS=
# Base URL of chatmaid for routine delivery; leave empty to disable.
TRAJECTREE_CHATMAID_URL=
# Self-hosted GitLab host name for the GitLab connector; leave empty for none.
TRAJECTREE_GITLAB_HOST=
